---
import Nav from './Nav.astro';

export interface Props {
  show?: boolean;
  currentPage: string;
  navLinks: string[];
}

const { show=false, currentPage, navLinks } = Astro.props;
---

<header>
  <a class="home-link" href="/"><h1>cdm</h1></a>
  <div class="NavWrap">
    <Nav currentPage={currentPage} navLinks={navLinks} />
  </div>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 10px 20px;

    @media (max-width: 500px) {
      gap: 10px;
      flex-direction: column;
      justify-content: center;
    }
  }
  .home-link {
    text-decoration-style: dashed !important;
    text-decoration-thickness: 4px;
    color: currentColor;

    &:focus-visible {
      outline-offset: 0;
      outline-style: dashed;
    }
    h1 {
      font-size: 20px;
      margin: 0;
    }
  }
</style>