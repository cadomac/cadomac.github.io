<button aria-label="Toggle font. Current font is pixelated style." class="FontButton">
    Aa
    <div class="font-tooltip">
        Toggle font
        <div class="point"></div>
    </div>
</button>

<style>
    .FontButton {
        appearance: none;
        border: none;
        height: 40px;
        width: 40px;
        font-size: 24px;
        background-color: var(--bg-color);
        box-shadow: 2px 2px 0 0 var(--contrast-color);
        border: 2px solid var(--contrast-color);
        color: var(--contrast-color);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        position: fixed;
        right: 5px;
        bottom: 5px;
        padding: 15px;

        body.no-pixel-font & {
            font-family: "Geist Pixel", sans-serif;
        }
        body:not(.no-pixel-font) & {
            font-family: "Red Hat Text", "Trebuchet MS", sans-serif;
        }

        &:hover,
        &:focus-visible {
            .font-tooltip {
                display: block;
            }
        }

        &:focus-visible {
            outline: 2px dashed var(--contrast-color);
            outline-offset: -6px;
        }

        .font-tooltip {
            background-color: var(--contrast-color);
            color: var(--contrast-text-color);
            position: absolute;
            font-size: 14px;
            width: 100px;
            height: 20px;
            right: 55px;
            display: none;

            .point {
                background-color: var(--contrast-color);
                height: 20px;
                width: 20px;
                position: absolute;
                right: -10px;
                top: 0;
                rotate: 45deg;
                scale: 0.71;
        }
    }
</style>

<script>
    const prefersNoPixelFont = localStorage.getItem("prefersNoPixelFont") ?? false;
    const button = document.querySelector('.FontButton');
    const body = document.querySelector('body');
    const pixelLabel = "Toggle font. Current font is pixelated style."
    const nonPixelLabel = "Toggle font. Current font is sans-serif style."

    window.onload = () => {
        if (prefersNoPixelFont) {
            body?.classList.add('no-pixel-font')
        }
    }

    function handleClick() {
        body?.classList.toggle('no-pixel-font');
        if (body?.classList.contains('no-pixel-font')) {
            button ? button.ariaLabel = nonPixelLabel : null
            localStorage.setItem("prefersNoPixelFont", "true")
        } else {
            button ? button.ariaLabel = pixelLabel : null
            localStorage.removeItem("prefersNoPixelFont")
        }
    }

    button?.addEventListener('click', handleClick);    
</script>