        color: var(--contrast-color);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        position: fixed;
        right: 15px;
        bottom: 15px;

        body.no-pixel-font & {
            font-family: "Geist Pixel", sans-serif;
