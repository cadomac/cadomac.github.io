                display: block;
            }
        }

        .font-tooltip {
            background-color: var(--contrast-color);
            color: var(--contrast-text-color);
            position: absolute;
            font-size: 14px;
            width: 100px;
            height: 20px;
            right: 50px;
            display: none;

            .point {
                background-color: var(--contrast-color);
                height: 20px;
                width: 20px;
                position: absolute;
                right: -10px;
                top: 0;
                rotate: 45deg;
                scale: 0.71;
