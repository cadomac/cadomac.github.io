<button aria-label="Toggle font. Current font is pixelated style." class="FontButton">
    Aa
    <div class="font-tooltip">
        Toggle font
        <div class="point"></div>
    </div>
</button>

<style>
    .FontButton {
        appearance: none;
        border: none;
        height: 40px;
        width: 40px;
        font-size: 24px;
