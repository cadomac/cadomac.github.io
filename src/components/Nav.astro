---
export interface Props {
    currentPage: string;
    navLinks: string[];
}

import NavCard from './NavCard.astro';

const { currentPage, navLinks } = Astro.props;
---

<nav class="SiteNav">
    {
        navLinks?.map((name: string) => (
            <NavCard currentPage={currentPage} title={name} />
        ))
    }
</nav>

<style>
    .SiteNav {
        display: flex;
        align-items: center;
        gap: 10px;

        @media (max-width: 500px) {
            flex-wrap: wrap;
            justify-content: center;
        }
    }
</style>
