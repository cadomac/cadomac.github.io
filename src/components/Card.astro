---
export interface Props {
    href?: string;
    title?: string;
    desc?: string;
    background?: string;
    backgroundImg?: string;
    external?: boolean;
    mail?: boolean;
}

const {
    href,
    title = "card title",
    desc,
    background = "off-white",
    backgroundImg,
    external = false,
    mail = false,
} = Astro.props;

const Tag = href ? "a" : "div";

// const id = title.replace(/\s|@|\.|:/g, "");

type JSON = {
    white: Function;
    black: Function;
    orange: Function;
    default: {
        [key: string]: string;
    };
};

---

<Tag
    class="Card"
    target={href && external ? "_blank" : null}
    href={href}
    aria-label={href ? `${title}, opens in new tab` : null}
>
    <h2 class="title">
        {title}
    </h2>
    {desc && <p class="desc">{desc}</p>}
</Tag>

<style>
    @keyframes hover-circle {
        0% {
            translate: 0 0;
        }

        25% {
            translate: 0px -3px;
        }

        50% {
            translate: -3px -3px;
        }

        75% {
            translate: -3px 0px;
        }

        100% {
            translate: 0 0;
        }
    }
    @keyframes hover-circle-inverse {
        0% {
            box-shadow: 6px 6px 0 0 var(--shadow-color);
        }

        25% {
            box-shadow: 6px 9px 0 0 var(--shadow-color);
        }

        50% {
            box-shadow: 9px 9px 0 0 var(--shadow-color);
        }

        75% {
            box-shadow: 9px 6px 0 0 var(--shadow-color);
        }

        100% {
            box-shadow: 6px 6px 0 0 var(--shadow-color);
        }
    }
    .Card {
        --shadow-color: var(--coffee-bean);
        --bg-color: var(--banana-cream);
    
        @media (prefers-color-scheme: dark) {
            --shadow-color: var(--snow);
            --bg-color: var(--petal-pink);
            /* --bg-color: var(--terminal-green); */
        }
        display: flex;
        flex-direction: column;
        width: 40cqw;
        height: auto;
        max-width: 400px;
        max-height: 200px;
        min-height: 100px;
        padding: 10px;
        border: 2px solid var(--shadow-color);
        box-shadow: 6px 6px 0 0 var(--shadow-color);
        transition: box-shadow 0.1s ease, translate 0.1s ease, transform 0.1s ease, color 0.1s ease;
        text-decoration: none;
        color: currentColor;
        position: relative;
        overflow: hidden;

        @media (max-width: 500px) {
            width: 100%;
        }

        &:hover,
        &:focus-visible {
            cursor: pointer;
            background-color: var(--bg-color);
            transform: skew(-1deg, 0);
            @media (prefers-reduced-motion: no-preference) {
                animation: hover-circle 2s steps(2) infinite, hover-circle-inverse 2s steps(2) infinite;
            }

            .title,
            .desc {
                transform: skew(-2deg, 0);
                text-decoration: 4px dashed underline;
            }

            .bg-color-swipe {
                top: 0;

                .bg-stripe {
                    
                }
            }
        }

        &:focus-visible {
            outline: 3px dashed var(--shadow-color);
            outline-offset: -6px;
        }

        .title,
        .desc {
            transition: all 0.1s ease;
        }

        .title {
            display: flex;
            align-items: center;
            margin: 0;
        }

        .desc {
            margin-top: 0;
        }
    }
</style>