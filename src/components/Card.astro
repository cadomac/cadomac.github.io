---
export interface Props {
    href?: string;
    title?: string;
    desc?: string;
    background?: string;
    backgroundImg?: string;
    external?: boolean;
    mail?: boolean;
}

const {
    href,
    title = "card title",
    desc,
    background = "off-white",
    backgroundImg,
    external = false,
    mail = false,
} = Astro.props;

const Tag = href ? "a" : "div";

// const id = title.replace(/\s|@|\.|:/g, "");

type JSON = {
    white: Function;
    black: Function;
    orange: Function;
    default: {
        [key: string]: string;
    };
};

---

<Tag
    class="Card"
    target={href && external ? "_blank" : null}
    href={href}
    aria-label={href ? `${title}, opens in new tab` : null}
>
    <div class="bg-color-swipe">
        <div class="bg-stripe">
            <div class="bg-stripe-seg-1" />
            <div class="bg-stripe-seg-2" />
            <div class="bg-stripe-seg-3" />
            <div class="bg-stripe-seg-1" />
            <div class="bg-stripe-seg-2" />
            <div class="bg-stripe-seg-3" />
        </div>
    </div>
    <h2 class="title">
        {title}
    </h2>
    {desc && <p class="desc">{desc}</p>}
</Tag>

<style>
    @keyframes scroll-loop {
        0% {
            left: -112%;
        }

        100% {
            left: 0%;
        }
    }
    .Card {
        --shadow-color: #000;
        --bg-color: yellow;
    
        @media (prefers-color-scheme: dark) {
            --shadow-color: white;
            --bg-color: hotpink;
        }
        display: flex;
        flex-direction: column;
        width: 40cqw;
        height: auto;
        max-width: 400px;
        max-height: 200px;
        min-height: 100px;
        padding: 10px;
        border: 2px solid var(--shadow-color);
        box-shadow: 6px 6px 0 0 var(--shadow-color);
        transition: box-shadow 0.1s ease, translate 0.1s ease, transform 0.1s ease, color 0.1s ease;
        text-decoration: none;
        color: currentColor;
        position: relative;
        overflow: hidden;

        @media (max-width: 500px) {
            width: 100%;
        }

        &:hover,
        &:focus-visible {
            box-shadow: 10px 10px 0 0 var(--shadow-color);
            cursor: pointer;
            translate: -2px -2px;
            transform: skew(-1deg, 0);

            .title,
            .desc {
                transform: skew(-2deg, 0);
            }

            .bg-color-swipe {
                top: 0;

                .bg-stripe {
                    
                }
            }
        }

        &:focus-visible {
            outline: 3px dashed var(--shadow-color);
            outline-offset: -6px;
        }

        .bg-color-swipe {
            background-color: var(--bg-color);
            position: absolute;
            display: block;
            height: 100%;
            width: 100%;
            top: 100%;
            left: 0;
            transition: top 0.2s ease;
            z-index: -1;
            

            .bg-stripe {
                display: flex;
                width: 220%;
                height: calc(1cqw + 10px);
                position: absolute;
                top: calc(82% - 1cqw);
                left: -100px;
                gap: 2cqw;
                animation: scroll-loop 5s linear forwards infinite;
                

                [class*="seg"] {
                    background-color: var(--shadow-color);
                    transform: skew(-34deg, 0);
                    display: flex;
                    gap:0;

                    .material-symbols-rounded {
                        display: block;
                        width: fit-content;
                    }
                }
                
                .bg-stripe-seg-1 {
                    width: 50%;
                }
                .bg-stripe-seg-2 {
                    width: 30%;
                }
                .bg-stripe-seg-3 {
                    width: 20%;
                }
            }
        }

        .title,
        .desc {
            transition: all 0.1s ease;
        }

        .title {
            display: flex;
            align-items: center;
            margin: 0;
        }

        .desc {
            margin-top: 0;
        }
    }
</style>