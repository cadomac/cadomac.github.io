---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";

const links = [
    {
        name: "Résumé",
        url: "/resume",
        blurb: "yes, i use the accent marks",
        color: "parchment",
    },
    {
        name: "Work",
        url: "/work",
        blurb: "projects, hobbies, general tomfoolery",
        color: "orange-web",
    },
    {
        name: "Blog",
        url: "/blog",
        blurb: "maybe some day, lol",
        color: "pink-orange",
    },
    {
        name: "Contact",
        url: "/contact",
        blurb: "carrier pigeon is preferred",
        color: "blue-light",
    },
];
---

<Layout title="Cameron MacDonald" isHome currentPage="home">
    <div class="home-wrapper">
        <h1>cameron macdonald</h1>
        <p>front end developer — artist — accessibility advocate</p>
        <div class="card-grid">
            <Card title="art" href="/design"/>
            <Card title="software" href="/software"/>
            <Card title="blog" href="/blog"/>
            <Card title="about" href="/about"/>
        </div>
    </div>
</Layout>

<style>
    .home-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    h1, p {
        text-align: center;
    }
    h1 {
        font-size: 64px;
        margin-bottom: 0;

        @media (max-width: 500px) {
            font-size: 30px;
        }
    }
    p {
        font-size: 20px;
        margin-top: 0;
        margin-bottom: 36px;
    }

    .card-grid {
        display: grid;
        grid-template: 1fr 1fr / 1fr 1fr;
        @media (max-width: 500px) {
            grid-template: 1fr / auto;
            width: 90%;
        }
        gap: 25px;
    }
</style>
