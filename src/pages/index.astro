---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";

const links = [
    {
        name: "Résumé",
        url: "/resume",
        blurb: "yes, i use the accent marks",
        color: "parchment",
    },
    {
        name: "Work",
        url: "/work",
        blurb: "projects, hobbies, general tomfoolery",
        color: "orange-web",
    },
    {
        name: "Blog",
        url: "/blog",
        blurb: "maybe some day, lol",
        color: "pink-orange",
    },
    {
        name: "Contact",
        url: "/contact",
        blurb: "carrier pigeon is preferred",
        color: "blue-light",
    },
];
---

<Layout title="Cameron MacDonald" isHome currentPage="home">
    <h1>back soon</h1>
    <p>giving this site some much-needed t.l.c.</p>
    <p>❤️</p>
    <p>cameron</p>
</Layout>

<style>
    h1, p {
        text-align: center;
    }
    h1 {
        font-size: 72px;
        margin-bottom: 0;

        @media (max-width: 400px) {
            font-size: 40px;
        }
    }
    p {
        font-size: 22px;
        @media (max-width: 400px) {
            font-size: 18px;
        }

        &:nth-of-type(2) {
            margin-bottom: 0;
        }
        &:last-of-type {
            margin-top: 0;
        }
    }
</style>
