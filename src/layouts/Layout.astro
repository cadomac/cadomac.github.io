---
export interface Props {
    title: string;
    isHome?: boolean;
    currentPage: string;
}

const { title, isHome = false, currentPage } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="Cameron MacDonald: front-end developer, accessibility specialist, "
        />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#000000" />
        <meta name="color-scheme" content="light dark" />
        <meta name="author" content="Cameron MacDonald" />
        <meta
            name="application-name"
            content="Personal website of Cameron MacDonald"
        />
        <meta name="AdsBot-Google" content="noindex" />
        <meta name="twitter:title" content="Cameron MacDonald" />
        <meta
            name="twitter:image"
            content="https://cdmacdonald.com/favicon.ico"
        />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="canonical" href="http://cdmacdonald.com" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <meta name="apple-mobile-web-app-title" content="CDM" />
        <link rel="manifest" href="/site.webmanifest" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <meta name="generator" content={Astro.generator} />
        <title>{title} | Cameron MacDonald</title>
    </head>
    <body>
        <main>
            <slot />
        </main>
        <link
            href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:ital,wght@0,400;0,900;1,400&family=Red+Hat+Text:ital,wght@0,400;0,900;1,400&display=swap"
            rel="preload"
            as="style"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:ital,wght@0,400;0,900;1,400&family=Red+Hat+Text:ital,wght@0,400;0,900;1,400&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=arrow_forward,expand_more,mail,open_in_new&display=swap"
            rel="stylesheet"
        />
    </body>
</html>
