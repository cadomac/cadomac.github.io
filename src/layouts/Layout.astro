---
export interface Props {
    title: string;
    isHome?: boolean;
    currentPage: string;
}

const { title, isHome = false, currentPage } = Astro.props;
import Header from "@components/Header.astro";
import { navLinks } from "../data/navLinks";

const icons = [
    "keyboard_double_arrow_right",
    "arrow_forward",
    "expand_more",
    "mail",
    "open_in_new",
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="The personal website of Cameron MacDonald, a front-end developer, UX designer, and accessibility specialist."
        />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#000000" />
        <meta name="color-scheme" content="light dark" />
        <meta name="author" content="Cameron MacDonald" />
        <meta
            name="application-name"
            content="Personal website of Cameron MacDonald"
        />
        <meta name="AdsBot-Google" content="noindex" />
        <meta name="twitter:title" content="Cameron MacDonald" />
        <meta
            name="twitter:image"
            content="https://cdmacdonald.com/favicon.ico"
        />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="canonical" href="http://cdmacdonald.com" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <meta name="apple-mobile-web-app-title" content="CDM" />
        <link rel="manifest" href="/site.webmanifest" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <meta name="generator" content={Astro.generator} />
        <title>{title === "Cameron MacDonald" ? title : `${title} | CM`}</title>
    </head>
    <body>
        {!isHome && <Header currentPage={currentPage} navLinks={navLinks} />}
        <main>
            <slot />
        </main>
        <link
            href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:ital,wght@0,400;0,900;1,400&family=Red+Hat+Text:ital,wght@0,400;0,900;1,400&display=swap"
            rel="preload"
            as="style"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:ital,wght@0,400;0,900;1,400&family=Red+Hat+Text:ital,wght@0,400;0,900;1,400&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <link
            href={`https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=${icons.sort().join(",")}&display=swap`}
            rel="stylesheet"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Geist+Pixel&display=swap"
            rel="stylesheet"
        />
    </body>
</html>
<style is:global>
    footer {
        display: none;

        @media (max-width: 400px) {
            display: flex;
            position: fixed;
            bottom: -25px;
            height: 100px;
            width: 100%;
            justify-content: center;

            & > .SiteNav {
                padding-top: 10px;
            }
        }
    }

    .material-symbols-rounded {
        font-family: "Material Symbols Rounded";
        font-weight: normal;
        font-style: normal;
        font-size: 24px;
        height: 24px;
        width: 24px;
        overflow: hidden;
        line-height: 1;
        letter-spacing: normal;
        text-transform: none;
        display: inline-block;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        -moz-font-feature-settings: "liga";
        -moz-osx-font-smoothing: grayscale;
    }

    :root {
        --contrast-color: black;
        --contrast-text-color: white;
        --terminal-green: #258f14;
        --orange: #e8ae0e;
        --hot-pink: hotpink;
        --banana-cream: #ffe747;
        --golden-glow: #deda0d;
        --petal-pink: #c45baa;
        --ink-black: #1a1103;
        --coffee-bean: #1b130e;
        --snow: #fffbff;
        --royal-orchid: #9c059e;

        --text-color: var(--ink-black);
        --text-color-hover: var(--snow);

        --primary: var(--royal-orchid);
        --secondary: var(--petal-pink);
        --shadow: var(--ink-black);

        --bg-color: var(--snow);
        --bright-contrast-color: var(--banana-cream);
        --bright-contrast-color-inverse: var(--petal-pink);

        @media (prefers-color-scheme: dark) {
            --contrast-color: white;
            --contrast-text-color: black;
            --bg-color: var(--coffee-bean);
            --bright-contrast-color: var(--petal-pink);
            --bright-contrast-color-inverse: var(--banana-cream);
            --primary: var(--orange);
            --secondary: var(--terminal-green);
            --shadow: var(--snow);
            --text-color: var(--snow);
            --text-color-hover: var(--ink-black);
        }
    }

    * {
        box-sizing: border-box;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: antialiased;
        -o-font-smoothing: antialiased;
        font-smoothing: antialiased;
        font-optical-sizing: auto;
        &:not(h1, h2, h3, h4, h5, h6) {
            font-family: "Geist Pixel", sans-serif;
        }
    }

    *:focus-visible {
        outline: 3px solid $off-white;
        border-radius: 2px;

        @media (prefers-color-scheme: light) {
            outline: 3px solid $black;
        }
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        /* font-family: "Red Hat Display", "Trebuchet MS", sans-serif; */
        font-family: "Geist Pixel", "Trebuchet MS", sans-serif;
    }

    html {
        background: var(--bg-color);
    }

    body {
        background: var(--bg-color);
        margin: 0;
        container: body / inline-size;
        height: 100%;
        position: relative;

        & main {
            margin: 0 auto 4rem auto;
            max-width: min(1280px, 90cqw);
            height: 100%;
        }

        &.no-pixel-font {
            h1,
            h2,
            h3,
            h4,
            h5,
            h6 {
                font-family: "Red Hat Display", "Trebuchet MS", sans-serif;
            }
            :not(h1, h2, h3, h4, h5, h6) {
                font-family: "Red Hat Text", "Trebuchet MS", sans-serif;
            }
        }
    }
</style>
